# =============================================================================
# Banco local (pgAdmin) — copie estas linhas para o seu .env
# =============================================================================
# Isso ativa o adaptador local (localDbClient) no supabaseClient e elimina
# o erro de "schema cache" nas telas de Campanhas. Troque sua_senha pela
# senha real do usuário postgres no pgAdmin.
# =============================================================================

VITE_USE_LOCAL_DB=true
VITE_LOCAL_API_URL=http://localhost:3001
DATABASE_URL=postgresql://postgres:sua_senha@localhost:5432/mural_digital
