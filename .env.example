# --- Nuvem ---
VITE_SUPABASE_PROJECT_ID=your_project_id
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_key
VITE_SUPABASE_URL=https://your_project.supabase.co

# --- Banco LOCAL (PostgreSQL no pgAdmin, sem Supabase Cloud) ---
# Padrão do app: modo local LIGADO. Só use Supabase Cloud com VITE_USE_LOCAL_DB=false
VITE_USE_LOCAL_DB=true
VITE_LOCAL_API_URL=http://localhost:3001
VITE_PAYMENT_MODE=manual
LOCAL_PAYMENT_MODE=manual
# Depois rode o schema: psql "$DATABASE_URL" -f local_schema_pgadmin.sql
# E inicie a API: npm run server

# Conexão Postgres para rodar init_local_db.sql
# Supabase local: postgres na porta 54322
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
# Postgres standalone (ex.: mural_digital): use porta 5432
# DATABASE_URL=postgresql://postgres:senha@localhost:5432/mural_digital

# Stripe (test) - opcional quando LOCAL_PAYMENT_MODE=manual
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─────────────────────────────────────────────────────────────────────────────
# SEGURANÇA — obrigatórias em produção (NODE_ENV=production)
# O servidor se recusa a iniciar sem JWT_SECRET e ALLOWED_ORIGINS.
# ─────────────────────────────────────────────────────────────────────────────

# Segredo de assinatura dos JWT. Mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Domínios do frontend autorizados a chamar a API, separados por vírgula.
# CORS aberto + credentials permite que qualquer site faça requisições
# autenticadas em nome do usuário logado.
ALLOWED_ORIGINS=https://muraldigital.com,https://www.muraldigital.com

# E-mail da conta com acesso ao painel administrativo.
# Sem esta variável, NINGUÉM é reconhecido como admin master.
MASTER_ADMIN_EMAIL=

# Segredo do endpoint de webhook do Stripe (formato whsec_...).
# Encontrado no painel do Stripe > Developers > Webhooks > seu endpoint.
# Sem ele, o webhook rejeita todos os eventos — inclusive os legítimos.
STRIPE_WEBHOOK_SECRET=

# Número de proxies reversos à frente da API (Nginx, Render, Cloudflare...).
# Normalmente 1. Sem isto, o rate limit de login trata todos os clientes
# como um único IP.
TRUST_PROXY_HOPS=1

# ─────────────────────────────────────────────────────────────────────────────
# BANCO LOCAL VIA DOCKER
#
# NÃO defina POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB / POSTGRES_PORT
# aqui. Esses valores são DERIVADOS automaticamente do DATABASE_URL acima
# pelo scripts/dbEnv.js, que o iniciar_projeto.bat executa antes de subir o
# container.
#
# Manter as duas coisas separadas já causou um bug real: o .env tinha só
# DATABASE_URL, o docker-compose caiu nos valores padrão e criou o banco com
# uma senha diferente da que a aplicação usava — "password authentication
# failed for user postgres".
#
# Para trocar usuário, senha, porta ou nome do banco, edite APENAS o
# DATABASE_URL. Se o volume já existir, apague-o para a nova senha valer:
#   docker compose down -v
# ─────────────────────────────────────────────────────────────────────────────

# Nome do container (único valor não derivado do DATABASE_URL).
POSTGRES_CONTAINER=supabase_local
